# Copie para .env na raiz, preencha e proteja com chmod 600. Nunca envie ao Git.
# IP ou DNS do host da aplicação, sem protocolo nem porta (não necessariamente o painel Portainer).
REPORT_DOMAIN=
# A conexão do indexador é configurada no servidor, sem campos no navegador.
INDEXER_IP=
INDEXER_PORT=9200
INDEXER_USER=
# Aspas simples preservam caracteres literais como $ e #.
INDEXER_PASSWORD=''
RETENTION_HOURS=24
