# Copie para .env na raiz e preencha. Não coloque senhas neste arquivo.
# IP ou DNS do host da aplicação, sem protocolo nem porta (não necessariamente o painel Portainer).
REPORT_DOMAIN=
# URLs HTTPS autorizadas do indexador: IP literal e porta; múltiplas separadas por vírgula.
INDEXER_ENDPOINTS=
RETENTION_HOURS=24
